name: Keepalive
# GitHub는 저장소 활동이 60일간 없으면 예약(schedule) 워크플로를 자동 중지합니다.
# 3주에 한 번 빈 커밋을 남겨 이를 방지합니다.
on:
  schedule:
    - cron: "0 3 1,21 * *"     # 매월 1일, 21일
  workflow_dispatch:
permissions:
  contents: write
jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: 빈 커밋 남기기
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git commit --allow-empty -m "chore: keepalive $(date -u +%Y-%m-%d)"
          git push
