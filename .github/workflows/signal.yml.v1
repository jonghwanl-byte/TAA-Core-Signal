name: TAA 시그널

on:
  schedule:
    # 20:40 UTC = 다음날 05:40 KST
    # GitHub 예약 실행은 30분 지연될 수 있어 30분 앞당겨 둡니다.
    # UTC 일~금(0-5) = KST 월~토 → 일요일 수신 제외
    - cron: "40 20 * * 0-5"
  workflow_dispatch:        # Actions 탭에서 수동 실행 버튼

concurrency:
  group: taa-signal
  cancel-in-progress: false

jobs:
  signal:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: 의존성 설치
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: 시그널 계산 및 전송
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID:   ${{ secrets.TELEGRAM_CHAT_ID }}
          PORTFOLIO_VALUE:    ${{ secrets.PORTFOLIO_VALUE }}
          ALWAYS_SEND:        ${{ vars.ALWAYS_SEND || 'true' }}
        run: python taa_signal.py | tee -a $GITHUB_STEP_SUMMARY
